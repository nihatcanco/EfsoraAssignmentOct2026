# Backend
# docker compose overrides this to point at the db container
DATABASE_URL=postgresql+psycopg://briefbase:briefbase@localhost:5433/briefbase
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440 # 1 day
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-5-5
# comma separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Frontend (frontend/.env.local, or Vercel project settings)
NEXT_PUBLIC_API_URL=http://localhost:8000
